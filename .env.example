# Variáveis que o `docker-compose.yml` lê. Copiar para `.env` e preencher.
#
# O compose tem omissões seguras para a demonstração, e é aí que está a armadilha:
# `JWT_SECRET` fica VAZIO por omissão, a sessão é assinada e logo rejeitada, e as
# três jornadas do Playwright caem com `reason=session-expired` — sem nenhum erro
# visível que diga porquê. A CI define-o por `env:` no workflow; localmente, ninguém
# define. É a primeira coisa a verificar quando os testes de e2e falham todos no login.

# Assina a sessão. Tem de ser o MESMO no gestor e no aluno (o compose já o garante),
# e o manager e o student validem-no. Mínimo 32 caracteres.
JWT_SECRET=

# true = backend simulado dentro de cada app (demo, sem nada externo).
# false = backend real, e então BACKEND_API_URL passa a ser obrigatório.
KIXI_MOCK=true
KIXI_ALLOW_MOCK_IN_PROD=false

# Só com KIXI_MOCK=false. Aponta para o Spring Boot.
BACKEND_API_URL=http://host.docker.internal:8080/api/v1

# Endereço público do gateway. É com ele que o gestor e o aluno constroem os
# redireccionamentos para a landing e para a /403 canónica. Os cabeçalhos Host e
# x-forwarded-host vêm do cliente e não são de confiança.
APP_ORIGIN=http://localhost:3000

# Porta que o gateway publica.
PORT=3000

# Landing: endereço público usado no canonical, no Open Graph e no sitemap. Entra no
# build. Vazio = https://kixi.creativemode.ao (produção); num ambiente de testes,
# pôr o desse ambiente para não o anunciar como se fosse o de produção.
NEXT_PUBLIC_SITE_URL=
# Contacto no rodapé da landing. Vazio = o rodapé não mostra nenhum endereço.
NEXT_PUBLIC_CONTACT_EMAIL=
# Morada e telefone, para o `Organization` do JSON-LD (#218): é o que permite a um agente
# verificar a legitimidade da entidade e responder a perguntas de contacto. Rua e
# localidade juntas formam o PostalAddress — sem as duas, o schema vai sem morada.
# Telefone, se existir, entra em `ContactPoint.telephone`.
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_STREET=
NEXT_PUBLIC_CONTACT_LOCALITY=
NEXT_PUBLIC_CONTACT_POSTAL_CODE=
NEXT_PUBLIC_CONTACT_COUNTRY=AO
# Google Analytics (G-XXXXXXXXXX). Vazio = sem analítica. Só carrega depois de o visitante aceitar os cookies.
NEXT_PUBLIC_GA_ID=

# Credenciais que a suite de e2e usa. Os valores abaixo são as contas do mock
# (`lib/mock/backend.ts`), com `Kixi1234!` como password do seed.
E2E_ADMIN_USERNAME=admin@kixi.ao
E2E_TEACHER_USERNAME=professor@kixi.ao
E2E_PASSWORD=Kixi1234!

# Apontar a suite para um ambiente gerido à parte em vez do compose local.
# Sem isto, o Playwright arranca o compose e espera pelo /healthz do gateway.
# E2E_BASE_URL=https://qua.exemplo.ao